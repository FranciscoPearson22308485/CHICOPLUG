# ─── Base de dados ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://chicoplug:chicoplug@localhost:5433/chicoplug?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origens autorizadas para CORS, separadas por vírgula.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
# URL público do frontend (usado em links de email e no sitemap).
PUBLIC_SITE_URL="http://localhost:3000"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: gerar com `openssl rand -base64 48`.
JWT_ACCESS_SECRET="dev-access-secret-troca-isto-em-producao-por-favor-mesmo"
JWT_REFRESH_SECRET="dev-refresh-secret-troca-isto-em-producao-por-favor-mesmo"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─── Cloudinary (uploads de imagens) ──────────────────────────────────────────
# Sem estas variáveis o backend usa automaticamente o armazenamento local
# em ./uploads e serve as imagens a partir de /static/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="chicoplug"

# ─── Multicaixa Express (EMIS) ────────────────────────────────────────────────
# PAYMENTS_PROVIDER: "mock" (simulador local completo) ou "multicaixa" (real).
# O adaptador real fica inerte até estas credenciais serem preenchidas.
PAYMENTS_PROVIDER="mock"
MULTICAIXA_API_URL="https://pagamentonline.emis.co.ao/online-payment-gateway/portal"
MULTICAIXA_POS_ID=""
MULTICAIXA_CALLBACK_URL="http://localhost:4000/api/payments/multicaixa/callback"
MULTICAIXA_WEBHOOK_SECRET=""
# Caminho para o certificado cliente .pem fornecido pela EMIS (mTLS).
MULTICAIXA_CERT_PATH=""
MULTICAIXA_CERT_PASSPHRASE=""

# ─── Loja ─────────────────────────────────────────────────────────────────────
SHIPPING_FLAT_RATE=3500
FREE_SHIPPING_THRESHOLD=100000

# ─── Administrador inicial (usado pelo seed) ──────────────────────────────────
SEED_ADMIN_EMAIL="admin@chicoplug.ao"
SEED_ADMIN_PASSWORD="ChicoPlug!2026"
