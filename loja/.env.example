DEBUG=True
ALLOWED_HOSTS="*"
SITE_URL="http://localhost:8000"

# ─── Base de dados ────────────────────────────────────────────────────────────
DB_NAME=chicoplug_py
DB_USER=chicoplug
DB_PASSWORD=chicoplug
DB_HOST=localhost
DB_PORT=5433

# ─── Loja ─────────────────────────────────────────────────────────────────────
CUSTO_ENVIO=3500
ENVIO_GRATIS_A_PARTIR_DE=100000

# ─── Pagamentos ───────────────────────────────────────────────────────────────
# "simulador" (local, funcional) ou "multicaixa" (real).
PAGAMENTOS_PROVEDOR=simulador
