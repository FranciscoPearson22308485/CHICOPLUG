{
  "name": "chicoplug-loja",
  "private": true,
  "description": "Build do CSS (Tailwind) para os templates Django.",
  "scripts": {
    "css": "tailwindcss -i assets/css/entrada.css -o static/css/loja.css",
    "css:watch": "tailwindcss -i assets/css/entrada.css -o static/css/loja.css --watch",
    "build": "tailwindcss -i assets/css/entrada.css -o static/css/loja.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  }
}
